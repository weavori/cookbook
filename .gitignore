# --- Local environment & secrets ---
# Never commit connection strings or API keys (DSNs, WEAVORI_API_KEY, ...).
.env
.env.*
!.env.example
*.pem
*.key
*.p12

# --- Example run output ---
# Don't commit data generated by the recipes (paste mode -> stdout redirects,
# sync exports, logs).
output/
*.log
*.out.json
*.out.csv

# --- OS cruft ---
.DS_Store
Thumbs.db
desktop.ini

# --- Editors & IDEs ---
.idea/
.vscode/
*.swp
*.swo
*~

# --- Node (future SDK / MCP examples) ---
node_modules/
dist/
.next/
coverage/

# --- Go (future Go examples) ---
bin/
*.test
